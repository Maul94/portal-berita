<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 font-sans flex items-center justify-center min-h-screen">
  <div class="text-center px-6 max-w-lg">
    <div class="text-9xl font-black text-slate-200 leading-none select-none"><%= code %></div>
    <div class="mt-6 mb-2">
      <div class="inline-flex items-center gap-2 mb-4">
        <div class="w-8 h-8 bg-red-600 rounded-lg flex items-center justify-center">
          <span class="text-white font-bold text-sm">PB</span>
        </div>
        <span class="font-extrabold text-sm text-slate-700">Portal<span class="text-red-600">Berita</span> <span class="text-slate-400 font-normal">Admin CMS</span></span>
      </div>
    </div>
    <h1 class="text-2xl font-bold text-slate-800 mb-2"><%= title %></h1>
    <p class="text-slate-500 mb-8 max-w-md mx-auto leading-relaxed"><%= message %></p>
    <div class="flex gap-3 justify-center flex-wrap">
      <a href="/admin" class="bg-red-600 text-white px-6 py-2.5 rounded-xl font-semibold hover:bg-red-700 transition-colors shadow-sm shadow-red-500/20">
        🏠 Dashboard
      </a>
      <button onclick="history.back()" class="bg-white text-slate-700 border border-slate-200 px-6 py-2.5 rounded-xl font-semibold hover:border-slate-400 hover:bg-slate-50 transition-colors">
        ← Kembali
      </button>
    </div>
    <% if (typeof details !== 'undefined' && details && process && process.env && process.env.NODE_ENV === 'development') { %>
    <div class="mt-8 text-left bg-slate-900 text-green-400 rounded-xl p-4 text-xs font-mono overflow-auto max-h-48">
      <p class="text-slate-400 mb-2">// Error details (development only)</p>
      <pre><%= details %></pre>
    </div>
    <% } %>
  </div>
</body>
</html>
