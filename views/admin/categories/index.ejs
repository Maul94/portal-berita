<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 font-sans">
<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col min-w-0">
    <% const pageTitle = 'Manajemen Kategori'; %>
    <%- include('../partials/topbar') %>
    <main class="flex-1 p-6 overflow-auto">

      <!-- Flash Messages -->
      <% if (success && success.length > 0) { success.forEach(msg => { %>
      <div class="flash-success mb-4 flex items-center gap-2">✅ <%= msg %></div>
      <% }) } %>
      <% if (error && error.length > 0) { error.forEach(msg => { %>
      <div class="flash-error mb-4 flex items-center gap-2">⚠️ <%= msg %></div>
      <% }) } %>

      <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

        <!-- Add Category Form -->
        <div class="xl:col-span-1">
          <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5 sticky top-24">
            <h3 class="font-bold text-slate-900 mb-4">➕ Tambah Kategori Baru</h3>
            <form action="/admin/categories/store" method="POST" class="space-y-4">
              
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Nama Kategori <span class="text-red-500">*</span></label>
                <input type="text" name="name" required placeholder="Contoh: Teknologi"
                  class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all">
              </div>

              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Deskripsi</label>
                <textarea name="description" rows="3" placeholder="Deskripsi singkat kategori..."
                  class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all resize-none"></textarea>
              </div>

              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Urutan Tampil</label>
                <input type="number" name="sort_order" value="0" min="0"
                  class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all">
                <p class="text-xs text-slate-400 mt-1">Angka kecil tampil lebih awal</p>
              </div>

              <div>
                <label class="flex items-center gap-3 cursor-pointer">
                  <input type="checkbox" name="is_active" value="1" checked
                    class="w-5 h-5 text-red-600 rounded border-slate-300 focus:ring-red-500 focus:ring-offset-0">
                  <div>
                    <span class="font-semibold text-slate-900 text-sm">Kategori Aktif</span>
                    <p class="text-xs text-slate-400">Tampilkan di menu navigasi</p>
                  </div>
                </label>
              </div>

              <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-4 rounded-xl transition-all shadow-sm shadow-red-500/20 text-sm">
                Simpan Kategori
              </button>
            </form>
          </div>
        </div>

        <!-- Categories Table -->
        <div class="xl:col-span-2">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h2 class="text-xl font-bold text-slate-900">Daftar Kategori</h2>
              <p class="text-sm text-slate-500"><%= categories.length %> kategori tersedia</p>
            </div>
          </div>

          <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <% if (categories.length === 0) { %>
            <div class="px-6 py-12 text-center text-slate-400">
              <div class="text-4xl mb-2">🏷️</div>
              <p>Belum ada kategori. Tambahkan kategori pertama Anda!</p>
            </div>
            <% } else { %>
            <div class="overflow-x-auto">
              <table class="w-full">
                <thead>
                  <tr class="bg-slate-50 text-left">
                    <th class="px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Kategori</th>
                    <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide hidden md:table-cell">Slug</th>
                    <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide hidden lg:table-cell text-center">Berita</th>
                    <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide text-center">Status</th>
                    <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                  <% categories.forEach(cat => { %>
                  <tr class="hover:bg-slate-50 transition-colors" id="row-<%= cat.id %>">
                    <td class="px-5 py-4">
                      <p class="font-semibold text-sm text-slate-900"><%= cat.name %></p>
                      <% if (cat.description) { %>
                      <p class="text-xs text-slate-400 mt-0.5 line-clamp-1"><%= cat.description %></p>
                      <% } %>
                    </td>
                    <td class="px-4 py-4 hidden md:table-cell">
                      <code class="text-xs bg-slate-100 text-slate-600 px-2 py-1 rounded-md"><%= cat.slug %></code>
                    </td>
                    <td class="px-4 py-4 hidden lg:table-cell text-center">
                      <span class="text-sm font-semibold text-slate-700"><%= cat.article_count || 0 %></span>
                      <span class="text-xs text-slate-400 block">berita</span>
                    </td>
                    <td class="px-4 py-4 text-center">
                      <% if (cat.is_active) { %>
                      <span class="text-xs font-semibold bg-green-100 text-green-700 px-2.5 py-1 rounded-full">Aktif</span>
                      <% } else { %>
                      <span class="text-xs font-semibold bg-slate-100 text-slate-500 px-2.5 py-1 rounded-full">Nonaktif</span>
                      <% } %>
                    </td>
                    <td class="px-4 py-4">
                      <div class="flex items-center gap-1">
                        <button onclick="openEditModal(<%= JSON.stringify(cat) %>)"
                          class="text-xs bg-blue-50 hover:bg-blue-100 text-blue-700 px-2.5 py-1.5 rounded-lg font-medium transition-colors whitespace-nowrap">✏️ Edit</button>
                        <% if (!cat.article_count || cat.article_count === 0) { %>
                        <form action="/admin/categories/<%= cat.id %>?_method=DELETE" method="POST"
                          onsubmit="return confirm('Hapus kategori &quot;<%= cat.name %>&quot;? Tindakan tidak dapat dibatalkan.')">
                          <button type="submit" class="text-xs bg-red-50 hover:bg-red-100 text-red-700 px-2.5 py-1.5 rounded-lg font-medium transition-colors">🗑️</button>
                        </form>
                        <% } else { %>
                        <span class="text-xs text-slate-400 px-2 py-1.5 cursor-not-allowed" title="Tidak bisa dihapus karena masih memiliki berita">🗑️</span>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<!-- Edit Modal -->
<div id="edit-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4" onclick="closeEditModal(event)">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6" onclick="event.stopPropagation()">
    <div class="flex items-center justify-between mb-5">
      <h3 class="font-bold text-slate-900 text-lg">✏️ Edit Kategori</h3>
      <button onclick="closeEditModal()" class="p-1 text-slate-400 hover:text-slate-600 rounded-lg hover:bg-slate-100">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <form id="edit-form" method="POST" class="space-y-4">
      <input type="hidden" name="_method" value="PUT">

      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Nama Kategori <span class="text-red-500">*</span></label>
        <input type="text" name="name" id="edit-name" required
          class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent">
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Deskripsi</label>
        <textarea name="description" id="edit-description" rows="3"
          class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent resize-none"></textarea>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Urutan Tampil</label>
        <input type="number" name="sort_order" id="edit-sort_order" min="0"
          class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent">
      </div>

      <div>
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" name="is_active" id="edit-is_active" value="1"
            class="w-5 h-5 text-red-600 rounded border-slate-300 focus:ring-red-500 focus:ring-offset-0">
          <span class="font-semibold text-slate-900 text-sm">Kategori Aktif</span>
        </label>
      </div>

      <div class="flex gap-3 pt-2">
        <button type="button" onclick="closeEditModal()" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-2.5 px-4 rounded-xl text-sm transition-colors">
          Batal
        </button>
        <button type="submit" class="flex-1 bg-red-600 hover:bg-red-700 text-white font-bold py-2.5 px-4 rounded-xl text-sm transition-colors shadow-sm">
          Simpan Perubahan
        </button>
      </div>
    </form>
  </div>
</div>

<script src="/js/main.js"></script>
<script>
function openEditModal(cat) {
  document.getElementById('edit-name').value = cat.name || '';
  document.getElementById('edit-description').value = cat.description || '';
  document.getElementById('edit-sort_order').value = cat.sort_order || 0;
  document.getElementById('edit-is_active').checked = !!cat.is_active;
  document.getElementById('edit-form').action = `/admin/categories/${cat.id}`;
  
  const modal = document.getElementById('edit-modal');
  modal.classList.remove('hidden');
  modal.classList.add('flex');
  document.getElementById('edit-name').focus();
}

function closeEditModal(event) {
  if (!event || event.target === document.getElementById('edit-modal')) {
    const modal = document.getElementById('edit-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }
}

// Close on Escape key
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') closeEditModal();
});
</script>
</body>
</html>
