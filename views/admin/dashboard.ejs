<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 font-sans">
<div class="flex min-h-screen">
  <%- include('./partials/sidebar') %>
  
  <div class="flex-1 flex flex-col min-w-0">
    <% const pageTitle = 'Dashboard Overview'; %>
    <%- include('./partials/topbar') %>
    
    <main class="flex-1 p-6 overflow-auto">
      
      <!-- Flash Messages -->
      <% if (success && success.length > 0) { success.forEach(msg => { %>
      <div class="flash-success mb-4 flex items-center gap-2"><span>✅</span> <%= msg %></div>
      <% }) } %>
      <% if (error && error.length > 0) { error.forEach(msg => { %>
      <div class="flash-error mb-4 flex items-center gap-2"><span>⚠️</span> <%= msg %></div>
      <% }) } %>
      
      <!-- Welcome -->
      <div class="mb-6">
        <h2 class="text-xl font-bold text-slate-900">Selamat datang, <%= user ? user.name : 'Admin' %>! 👋</h2>
        <p class="text-slate-500 text-sm">Berikut ringkasan aktivitas portal berita Anda.</p>
      </div>
      
      <!-- Stats Cards -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-3">
            <span class="text-2xl">📰</span>
            <span class="text-xs font-semibold bg-green-100 text-green-700 px-2 py-0.5 rounded-full">Tayang</span>
          </div>
          <div class="text-3xl font-black text-slate-900"><%= stats.totalPublished.toLocaleString('id-ID') %></div>
          <div class="text-sm text-slate-500 mt-1">Berita Dipublikasikan</div>
        </div>
        
        <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-3">
            <span class="text-2xl">👁</span>
            <span class="text-xs font-semibold bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full">Total</span>
          </div>
          <div class="text-3xl font-black text-slate-900"><%= Number(stats.totalViews).toLocaleString('id-ID') %></div>
          <div class="text-sm text-slate-500 mt-1">Total Pembaca</div>
        </div>
        
        <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-3">
            <span class="text-2xl">📝</span>
            <span class="text-xs font-semibold bg-yellow-100 text-yellow-700 px-2 py-0.5 rounded-full">Draft</span>
          </div>
          <div class="text-3xl font-black text-slate-900"><%= stats.totalDraft.toLocaleString('id-ID') %></div>
          <div class="text-sm text-slate-500 mt-1">Berita Draft</div>
        </div>
        
        <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-3">
            <span class="text-2xl">🏷️</span>
            <span class="text-xs font-semibold bg-purple-100 text-purple-700 px-2 py-0.5 rounded-full">Aktif</span>
          </div>
          <div class="text-3xl font-black text-slate-900"><%= stats.totalCategories %></div>
          <div class="text-sm text-slate-500 mt-1">Kategori Aktif</div>
        </div>
      </div>
      
      <!-- Recent Articles Table -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
          <h3 class="font-bold text-slate-900">Berita Terbaru</h3>
          <a href="/admin/articles" class="text-sm text-red-600 hover:underline font-medium">Lihat Semua →</a>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="bg-slate-50 text-left">
                <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Judul</th>
                <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide hidden md:table-cell">Kategori</th>
                <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide hidden lg:table-cell">Views</th>
                <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Status</th>
                <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
              <% if (recentArticles && recentArticles.length > 0) { %>
              <% recentArticles.forEach(article => { %>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4">
                  <p class="font-semibold text-sm text-slate-900 line-clamp-2 max-w-xs"><%= article.title %></p>
                  <p class="text-xs text-slate-400 mt-0.5"><%= article.published_at ? formatDate(article.published_at) : 'Belum tayang' %></p>
                </td>
                <td class="px-4 py-4 hidden md:table-cell">
                  <span class="text-xs bg-slate-100 text-slate-600 px-2 py-1 rounded-md"><%= article.category_name || '-' %></span>
                </td>
                <td class="px-4 py-4 text-sm text-slate-600 hidden lg:table-cell">
                  <span class="flex items-center gap-1">👁 <%= (article.views_count || 0).toLocaleString('id-ID') %></span>
                </td>
                <td class="px-4 py-4">
                  <% if (article.status === 'published') { %>
                  <span class="inline-flex items-center gap-1 text-xs font-semibold bg-green-100 text-green-700 px-2.5 py-1 rounded-full">✓ Tayang</span>
                  <% } else if (article.status === 'draft') { %>
                  <span class="inline-flex items-center gap-1 text-xs font-semibold bg-yellow-100 text-yellow-700 px-2.5 py-1 rounded-full">✎ Draft</span>
                  <% } else { %>
                  <span class="text-xs text-slate-400 capitalize px-2.5 py-1 bg-slate-100 rounded-full"><%= article.status %></span>
                  <% } %>
                </td>
                <td class="px-4 py-4">
                  <div class="flex items-center gap-1">
                    <a href="/admin/articles/<%= article.id %>/edit" class="text-xs bg-slate-100 hover:bg-blue-100 text-slate-600 hover:text-blue-700 px-2.5 py-1 rounded-lg font-medium transition-colors">Edit</a>
                    <% if (article.status === 'published') { %>
                    <a href="/artikel/<%= article.slug %>" target="_blank" class="text-xs bg-slate-100 hover:bg-green-100 text-slate-600 hover:text-green-700 px-2.5 py-1 rounded-lg font-medium transition-colors">↗ Lihat</a>
                    <% } %>
                  </div>
                </td>
              </tr>
              <% }) %>
              <% } else { %>
              <tr>
                <td colspan="5" class="px-6 py-12 text-center text-slate-400">
                  <div class="text-4xl mb-2">📭</div>
                  <p>Belum ada berita. <a href="/admin/articles/create" class="text-red-600 font-medium hover:underline">Buat sekarang →</a></p>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="px-6 py-4 border-t border-slate-100 text-center">
          <a href="/admin/articles/create" class="inline-flex items-center gap-2 bg-red-600 text-white text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-red-700 transition-colors shadow-sm shadow-red-500/20">
            + Buat Berita Baru
          </a>
        </div>
      </div>
    </main>
  </div>
</div>
<script src="/js/main.js"></script>
</body>
</html>
