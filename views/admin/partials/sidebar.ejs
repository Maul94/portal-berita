<!-- Admin Sidebar -->
<aside class="w-64 bg-white border-r border-slate-100 flex flex-col min-h-screen flex-shrink-0 hidden lg:flex">
  <!-- Logo -->
  <div class="px-6 py-5 border-b border-slate-100">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 bg-red-600 rounded-lg flex items-center justify-center">
        <span class="text-white font-bold text-sm">PB</span>
      </div>
      <div>
        <span class="font-extrabold text-sm text-slate-900">Portal<span class="text-red-600">Berita</span></span>
        <p class="text-xs text-slate-400">Admin CMS</p>
      </div>
    </div>
  </div>
  
  <!-- Nav Items -->
  <nav class="flex-1 px-3 py-4 space-y-1">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest px-3 mb-2">Menu Utama</p>
    <a href="/admin" class="admin-sidebar-link <%= currentPath === '/admin' ? 'active' : '' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
      Dashboard
    </a>
    <a href="/admin/articles" class="admin-sidebar-link <%= currentPath.startsWith('/admin/articles') ? 'active' : '' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
      Manajemen Berita
    </a>
    <a href="/admin/categories" class="admin-sidebar-link <%= currentPath.startsWith('/admin/categories') ? 'active' : '' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
      Kategori
    </a>
    
    <div class="pt-4">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest px-3 mb-2">Lainnya</p>
      <a href="/" target="_blank" class="admin-sidebar-link">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        Lihat Website
      </a>
      <a href="/admin/logout" class="admin-sidebar-link text-red-500 hover:bg-red-50 hover:text-red-600">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        Logout
      </a>
    </div>
  </nav>
  
  <!-- User Info -->
  <% if (user) { %>
  <div class="px-4 py-4 border-t border-slate-100">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 bg-gradient-to-br from-red-500 to-orange-400 rounded-full flex items-center justify-center text-white font-bold text-sm flex-shrink-0">
        <%= user.name ? user.name[0].toUpperCase() : 'A' %>
      </div>
      <div class="min-w-0">
        <p class="text-sm font-semibold text-slate-900 truncate"><%= user.name %></p>
        <p class="text-xs text-slate-400 truncate"><%= user.email %></p>
      </div>
    </div>
  </div>
  <% } %>
</aside>

<!-- Mobile Sidebar Overlay -->
<div id="mobile-sidebar-overlay" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden" onclick="closeMobileSidebar()"></div>

<!-- Mobile Sidebar -->
<aside id="mobile-sidebar" class="fixed left-0 top-0 bottom-0 w-64 bg-white border-r border-slate-100 flex flex-col z-50 transform -translate-x-full transition-transform duration-300 lg:hidden">
  <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 bg-red-600 rounded-lg flex items-center justify-center">
        <span class="text-white font-bold text-sm">PB</span>
      </div>
      <span class="font-extrabold text-sm text-slate-900">Portal<span class="text-red-600">Berita</span></span>
    </div>
    <button onclick="closeMobileSidebar()" class="p-1 text-slate-400 hover:text-slate-600">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>
  <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest px-3 mb-2">Menu Utama</p>
    <a href="/admin" class="admin-sidebar-link <%= currentPath === '/admin' ? 'active' : '' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"/></svg>
      Dashboard
    </a>
    <a href="/admin/articles" class="admin-sidebar-link <%= currentPath.startsWith('/admin/articles') ? 'active' : '' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
      Manajemen Berita
    </a>
    <a href="/admin/categories" class="admin-sidebar-link <%= currentPath.startsWith('/admin/categories') ? 'active' : '' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
      Kategori
    </a>
    <div class="pt-4">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest px-3 mb-2">Lainnya</p>
      <a href="/" target="_blank" class="admin-sidebar-link">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        Lihat Website
      </a>
      <a href="/admin/logout" class="admin-sidebar-link text-red-500 hover:bg-red-50 hover:text-red-600">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        Logout
      </a>
    </div>
  </nav>
  <% if (user) { %>
  <div class="px-4 py-4 border-t border-slate-100">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 bg-gradient-to-br from-red-500 to-orange-400 rounded-full flex items-center justify-center text-white font-bold text-sm flex-shrink-0">
        <%= user.name ? user.name[0].toUpperCase() : 'A' %>
      </div>
      <div class="min-w-0">
        <p class="text-sm font-semibold text-slate-900 truncate"><%= user.name %></p>
        <p class="text-xs text-slate-400 truncate"><%= user.email %></p>
      </div>
    </div>
  </div>
  <% } %>
</aside>
