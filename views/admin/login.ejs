<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gradient-to-br from-slate-900 to-slate-800 min-h-screen flex items-center justify-center font-sans">
  <div class="w-full max-w-md px-6">
    
    <!-- Logo -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-3 mb-2">
        <div class="w-12 h-12 bg-red-600 rounded-2xl flex items-center justify-center shadow-lg shadow-red-500/30">
          <span class="text-white font-black text-xl">PB</span>
        </div>
        <span class="font-extrabold text-2xl text-white">Portal<span class="text-red-400">Berita</span></span>
      </div>
      <p class="text-slate-400 text-sm">Masuk ke Dashboard Admin</p>
    </div>
    
    <!-- Flash Messages -->
    <% if (error && error.length > 0) { error.forEach(msg => { %>
    <div class="bg-red-900/50 border border-red-700 text-red-300 text-sm px-4 py-3 rounded-xl mb-4 flex items-center gap-2">
      <span>⚠️</span> <%= msg %>
    </div>
    <% }) } %>
    <% if (success && success.length > 0) { success.forEach(msg => { %>
    <div class="bg-green-900/50 border border-green-700 text-green-300 text-sm px-4 py-3 rounded-xl mb-4 flex items-center gap-2">
      <span>✅</span> <%= msg %>
    </div>
    <% }) } %>
    
    <!-- Login Form -->
    <div class="bg-white rounded-2xl shadow-2xl shadow-black/30 p-8">
      <h2 class="text-xl font-bold text-slate-900 mb-6">Login Admin</h2>
      
      <form action="/admin/login" method="POST" class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="email">Email</label>
          <input type="email" id="email" name="email" required placeholder="admin@portalberita.id"
            class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all"
            autocomplete="email">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="password">Password</label>
          <div class="relative">
            <input type="password" id="password" name="password" required placeholder="••••••••"
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all pr-12"
              autocomplete="current-password">
            <button type="button" onclick="togglePassword()" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs font-medium">
              👁
            </button>
          </div>
          <p class="text-xs text-slate-400 mt-1">Default: admin@portalberita.id / admin123</p>
        </div>
        <button type="submit"
          class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-4 rounded-xl transition-all duration-200 shadow-lg shadow-red-500/20 hover:shadow-red-500/40 mt-2">
          Masuk ke Dashboard
        </button>
      </form>
    </div>
    
    <p class="text-center text-slate-500 text-xs mt-6">
      <a href="/" class="hover:text-white transition-colors">← Kembali ke Portal Berita</a>
    </p>
  </div>
  <script>
  function togglePassword() {
    const inp = document.getElementById('password');
    inp.type = inp.type === 'password' ? 'text' : 'password';
  }
  </script>
</body>
</html>
