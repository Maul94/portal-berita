<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 font-sans">
<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col min-w-0">
    <% const pageTitle = 'Manajemen Berita'; %>
    <%- include('../partials/topbar') %>
    <main class="flex-1 p-6 overflow-auto">
      
      <!-- Flash Messages -->
      <% if (success && success.length > 0) { success.forEach(msg => { %>
      <div class="flash-success mb-4 flex items-center gap-2">✅ <%= msg %></div>
      <% }) } %>
      <% if (error && error.length > 0) { error.forEach(msg => { %>
      <div class="flash-error mb-4 flex items-center gap-2">⚠️ <%= msg %></div>
      <% }) } %>
      
      <!-- Header + Create button -->
      <div class="flex items-center justify-between mb-5">
        <div>
          <h2 class="text-xl font-bold text-slate-900">Daftar Berita</h2>
          <p class="text-sm text-slate-500">Total: <%= total %> berita ditemukan</p>
        </div>
        <a href="/admin/articles/create" class="inline-flex items-center gap-2 bg-red-600 text-white text-sm font-semibold px-4 py-2.5 rounded-xl hover:bg-red-700 transition-colors shadow-sm shadow-red-500/20">
          + Buat Berita
        </a>
      </div>
      
      <!-- Filters -->
      <form action="/admin/articles" method="GET" class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4 mb-5">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
          <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="🔍 Cari judul berita..."
            class="px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all">
          <select name="category" class="px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent">
            <option value="">Semua Kategori</option>
            <% categories.forEach(cat => { %>
            <option value="<%= cat.slug %>" <%= filters.category === cat.slug ? 'selected' : '' %>><%= cat.name %></option>
            <% }) %>
          </select>
          <select name="status" class="px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent">
            <option value="">Semua Status</option>
            <option value="published" <%= filters.status === 'published' ? 'selected' : '' %>>✓ Tayang</option>
            <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>✎ Draft</option>
            <option value="archived" <%= filters.status === 'archived' ? 'selected' : '' %>>Arsip</option>
          </select>
          <div class="flex gap-2">
            <button type="submit" class="flex-1 bg-red-600 text-white text-sm font-semibold px-4 py-2.5 rounded-xl hover:bg-red-700 transition-colors">Filter</button>
            <a href="/admin/articles" class="bg-slate-100 text-slate-600 text-sm font-semibold px-4 py-2.5 rounded-xl hover:bg-slate-200 transition-colors flex items-center">Reset</a>
          </div>
        </div>
      </form>
      
      <!-- Articles Table -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="bg-slate-50 text-left">
                <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Berita</th>
                <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide hidden md:table-cell">Kategori</th>
                <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide hidden lg:table-cell">Views</th>
                <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Status</th>
                <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
              <% if (articles.length === 0) { %>
              <tr>
                <td colspan="5" class="px-6 py-12 text-center text-slate-400">
                  <div class="text-4xl mb-2">📭</div>
                  <p class="mb-3">Tidak ada berita yang cocok dengan filter Anda.</p>
                  <a href="/admin/articles/create" class="inline-flex items-center gap-1 text-sm font-semibold text-red-600 hover:underline">+ Buat Berita Baru</a>
                </td>
              </tr>
              <% } else { %>
              <% articles.forEach(article => { %>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4">
                  <div class="flex items-start gap-3">
                    <% if (article.thumbnail_url) { %>
                    <img src="<%= article.thumbnail_url %>" alt="" class="w-14 h-10 object-cover rounded-lg flex-shrink-0 hidden sm:block">
                    <% } else { %>
                    <div class="w-14 h-10 bg-slate-100 rounded-lg flex-shrink-0 hidden sm:block flex items-center justify-center text-slate-400 text-lg">📰</div>
                    <% } %>
                    <div>
                      <% if (article.is_headline) { %>
                      <span class="text-xs bg-red-100 text-red-600 font-semibold px-1.5 py-0.5 rounded mb-1 inline-block">★ Headline</span>
                      <% } %>
                      <p class="font-semibold text-sm text-slate-900 line-clamp-2 max-w-sm"><%= article.title %></p>
                      <p class="text-xs text-slate-400 mt-0.5"><%= article.published_at ? formatDate(article.published_at) : 'Belum tayang' %></p>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-4 hidden md:table-cell">
                  <span class="text-xs bg-slate-100 text-slate-600 px-2 py-1 rounded-md"><%= article.category_name || '-' %></span>
                </td>
                <td class="px-4 py-4 text-sm text-slate-600 hidden lg:table-cell">
                  👁 <%= (article.views_count || 0).toLocaleString('id-ID') %>
                </td>
                <td class="px-4 py-4">
                  <% if (article.status === 'published') { %>
                  <span class="text-xs font-semibold bg-green-100 text-green-700 px-2.5 py-1 rounded-full whitespace-nowrap">✓ Tayang</span>
                  <% } else if (article.status === 'draft') { %>
                  <span class="text-xs font-semibold bg-yellow-100 text-yellow-700 px-2.5 py-1 rounded-full whitespace-nowrap">✎ Draft</span>
                  <% } else { %>
                  <span class="text-xs text-slate-400 capitalize px-2.5 py-1 bg-slate-100 rounded-full"><%= article.status %></span>
                  <% } %>
                </td>
                <td class="px-4 py-4">
                  <div class="flex items-center gap-1 flex-wrap">
                    <a href="/admin/articles/<%= article.id %>/edit" class="text-xs bg-blue-50 hover:bg-blue-100 text-blue-700 px-2.5 py-1.5 rounded-lg font-medium transition-colors whitespace-nowrap">✏️ Edit</a>
                    <% if (article.status === 'published') { %>
                    <a href="/artikel/<%= article.slug %>" target="_blank" class="text-xs bg-green-50 hover:bg-green-100 text-green-700 px-2.5 py-1.5 rounded-lg font-medium transition-colors whitespace-nowrap">↗ Lihat</a>
                    <% } %>
                    <form action="/admin/articles/<%= article.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Hapus berita ini? Tindakan tidak dapat dibatalkan.')">
                      <button type="submit" class="text-xs bg-red-50 hover:bg-red-100 text-red-700 px-2.5 py-1.5 rounded-lg font-medium transition-colors">🗑️</button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
        
        <!-- Pagination -->
        <% if (totalPages > 1) { %>
        <div class="px-6 py-4 border-t border-slate-100 flex items-center justify-between flex-wrap gap-3">
          <p class="text-sm text-slate-500">Halaman <%= page %> dari <%= totalPages %></p>
          <div class="flex gap-1 flex-wrap">
            <% if (page > 1) { %>
            <a href="?page=<%= page - 1 %>&search=<%= filters.search || '' %>&category=<%= filters.category || '' %>&status=<%= filters.status || '' %>"
              class="bg-slate-100 text-slate-600 hover:bg-slate-200 w-8 h-8 flex items-center justify-center rounded-lg text-sm font-semibold transition-colors">‹</a>
            <% } %>
            <% for (let i = Math.max(1, page - 2); i <= Math.min(totalPages, page + 2); i++) { %>
            <a href="?page=<%= i %>&search=<%= filters.search || '' %>&category=<%= filters.category || '' %>&status=<%= filters.status || '' %>"
              class="<%= i === page ? 'bg-red-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %> w-8 h-8 flex items-center justify-center rounded-lg text-sm font-semibold transition-colors">
              <%= i %>
            </a>
            <% } %>
            <% if (page < totalPages) { %>
            <a href="?page=<%= page + 1 %>&search=<%= filters.search || '' %>&category=<%= filters.category || '' %>&status=<%= filters.status || '' %>"
              class="bg-slate-100 text-slate-600 hover:bg-slate-200 w-8 h-8 flex items-center justify-center rounded-lg text-sm font-semibold transition-colors">›</a>
            <% } %>
          </div>
        </div>
        <% } %>
      </div>
    </main>
  </div>
</div>
<script src="/js/main.js"></script>
</body>
</html>
