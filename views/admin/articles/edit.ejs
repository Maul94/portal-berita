<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 font-sans">
<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col min-w-0">
    <% const pageTitle = 'Edit Berita'; %>
    <%- include('../partials/topbar') %>
    <main class="flex-1 p-6 overflow-auto">
      
      <!-- Flash Messages -->
      <% if (error && error.length > 0) { error.forEach(msg => { %>
      <div class="flash-error mb-4 flex items-center gap-2">⚠️ <%= msg %></div>
      <% }) } %>
      <% if (success && success.length > 0) { success.forEach(msg => { %>
      <div class="flash-success mb-4 flex items-center gap-2">✅ <%= msg %></div>
      <% }) } %>

      <!-- Back link + View link -->
      <div class="mb-4 flex items-center justify-between">
        <a href="/admin/articles" class="text-sm text-slate-500 hover:text-slate-700 flex items-center gap-1 w-fit">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Kembali ke Daftar Berita
        </a>
        <% if (article.status === 'published') { %>
        <a href="/artikel/<%= article.slug %>" target="_blank" class="text-sm text-green-600 hover:text-green-700 flex items-center gap-1 font-medium">
          ↗ Lihat di Web
        </a>
        <% } %>
      </div>
      
      <form action="/admin/articles/<%= article.id %>?_method=PUT" method="POST" enctype="multipart/form-data" id="article-form">
        <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
          
          <!-- Main Content -->
          <div class="xl:col-span-2 space-y-5">
            
            <!-- Title -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
              <label class="block text-sm font-semibold text-slate-700 mb-2">Judul Berita <span class="text-red-500">*</span></label>
              <input type="text" name="title" id="title" required placeholder="Tulis judul berita yang menarik..."
                class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-base font-semibold focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all"
                value="<%= article.title %>" oninput="generateSlugPreview(this.value)">
              <div class="mt-2 text-xs text-slate-400">
                URL: <code class="bg-slate-100 px-2 py-0.5 rounded text-slate-600">/artikel/<span id="slug-preview" class="text-red-500"><%= article.slug %></span></code>
              </div>
            </div>
            
            <!-- Excerpt -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
              <label class="block text-sm font-semibold text-slate-700 mb-2">
                Ringkasan / Excerpt
                <span class="text-slate-400 font-normal text-xs">(untuk SEO & preview kartu berita)</span>
              </label>
              <textarea name="excerpt" rows="3" placeholder="Tulis ringkasan singkat artikel (120-200 karakter ideal untuk SEO)..."
                class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all resize-none"><%= article.excerpt || '' %></textarea>
            </div>
            
            <!-- Content Editor -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
              <label class="block text-sm font-semibold text-slate-700 mb-3">Konten Artikel <span class="text-red-500">*</span></label>
              <div id="quill-editor" class="rounded-xl border border-slate-200 overflow-hidden">
                <div id="toolbar">
                  <span class="ql-formats"><button class="ql-header" value="2"></button><button class="ql-header" value="3"></button></span>
                  <span class="ql-formats"><button class="ql-bold"></button><button class="ql-italic"></button><button class="ql-underline"></button><button class="ql-strike"></button></span>
                  <span class="ql-formats"><button class="ql-blockquote"></button><button class="ql-code-block"></button></span>
                  <span class="ql-formats"><button class="ql-list" value="ordered"></button><button class="ql-list" value="bullet"></button></span>
                  <span class="ql-formats"><button class="ql-align" value=""></button><button class="ql-align" value="center"></button><button class="ql-align" value="right"></button></span>
                  <span class="ql-formats"><button class="ql-link"></button><button class="ql-image"></button></span>
                  <span class="ql-formats"><button class="ql-clean"></button></span>
                </div>
                <div id="editor-content" style="min-height:400px;font-size:15px;"></div>
              </div>
              <input type="hidden" name="content" id="content-input">
            </div>
          </div>
          
          <!-- Sidebar Options -->
          <div class="space-y-5">
            
            <!-- Publish Actions -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
              <h3 class="font-bold text-slate-900 mb-1">Publikasi</h3>
              <p class="text-xs text-slate-400 mb-4">
                Status saat ini: 
                <% if (article.status === 'published') { %>
                  <span class="text-green-600 font-semibold">✓ Tayang</span>
                <% } else if (article.status === 'draft') { %>
                  <span class="text-yellow-600 font-semibold">✎ Draft</span>
                <% } else { %>
                  <span class="text-slate-600 font-semibold capitalize"><%= article.status %></span>
                <% } %>
              </p>
              <div class="space-y-3">
                <button type="submit" name="status" value="draft" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-3 px-4 rounded-xl transition-all text-sm">
                  💾 Simpan sebagai Draft
                </button>
                <button type="submit" name="status" value="published" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-4 rounded-xl transition-all shadow-sm shadow-red-500/20 text-sm">
                  🚀 Publikasikan / Perbarui
                </button>
                <% if (article.status !== 'archived') { %>
                <button type="submit" name="status" value="archived" class="w-full bg-slate-50 hover:bg-slate-100 text-slate-500 font-medium py-2 px-4 rounded-xl transition-all text-xs border border-slate-200">
                  Arsipkan Berita
                </button>
                <% } %>
              </div>
            </div>
            
            <!-- Category -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
              <label class="block text-sm font-semibold text-slate-700 mb-2">Kategori <span class="text-red-500">*</span></label>
              <select name="category_id" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent">
                <option value="">Pilih Kategori...</option>
                <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>" <%= article.category_id == cat.id ? 'selected' : '' %>><%= cat.name %></option>
                <% }) %>
              </select>
            </div>
            
            <!-- Thumbnail -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
              <label class="block text-sm font-semibold text-slate-700 mb-2">Foto Utama (Thumbnail)</label>
              <div id="thumb-preview" class="relative bg-slate-100 rounded-xl overflow-hidden mb-3 flex items-center justify-center" style="aspect-ratio:16/9;">
                <% if (article.thumbnail_url) { %>
                <img src="<%= article.thumbnail_url %>" alt="Thumbnail" class="w-full h-full object-cover absolute inset-0">
                <% } else { %>
                <span class="text-slate-400 text-3xl">🖼️</span>
                <% } %>
              </div>
              <label class="block w-full cursor-pointer">
                <span class="block w-full bg-slate-50 border border-dashed border-slate-300 hover:border-red-400 text-slate-500 hover:text-red-500 text-sm font-medium py-3 px-4 rounded-xl text-center transition-colors">
                  📁 <%= article.thumbnail_url ? 'Ganti Gambar' : 'Pilih Gambar' %> (Maks. 5MB)
                </span>
                <input type="file" name="thumbnail" accept="image/*" class="hidden" id="thumbnail-input" onchange="previewThumbnail(this)">
              </label>
              <input type="text" name="thumbnail_caption" placeholder="Kredit foto / keterangan gambar..."
                value="<%= article.thumbnail_caption || '' %>"
                class="w-full mt-2 px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-red-500">
            </div>
            
            <!-- Tags -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
              <label class="block text-sm font-semibold text-slate-700 mb-2">Tags / Topik</label>
              <input type="text" name="tags" placeholder="nusantara, ibu-kota, kebijakan"
                value="<%= typeof tagString !== 'undefined' ? tagString : '' %>"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent">
              <p class="text-xs text-slate-400 mt-1">Pisahkan dengan koma</p>
            </div>
            
            <!-- Headline Checkbox -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="checkbox" name="is_headline" value="on"
                  <%= article.is_headline ? 'checked' : '' %>
                  class="w-5 h-5 text-red-600 rounded border-slate-300 focus:ring-red-500 focus:ring-offset-0">
                <div>
                  <span class="font-semibold text-slate-900 text-sm">Jadikan Headline Utama</span>
                  <p class="text-xs text-slate-400">Tampilkan sebagai berita utama di beranda</p>
                </div>
              </label>
            </div>

            <!-- Danger Zone -->
            <div class="bg-white rounded-2xl border border-red-100 shadow-sm p-5">
              <h3 class="font-bold text-red-700 mb-3 text-sm">⚠️ Zona Berbahaya</h3>
              <form action="/admin/articles/<%= article.id %>?_method=DELETE" method="POST" onsubmit="return confirm('HAPUS berita ini secara permanen? Tindakan TIDAK dapat dibatalkan!')">
                <button type="submit" class="w-full bg-red-50 hover:bg-red-100 text-red-700 font-semibold py-2.5 px-4 rounded-xl transition-all text-sm border border-red-200">
                  🗑️ Hapus Berita Ini
                </button>
              </form>
            </div>
          </div>
        </div>
      </form>
    </main>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script src="/js/main.js"></script>
<script>
// Initialize Quill with existing content
const quill = new Quill('#editor-content', {
  theme: 'snow',
  modules: { toolbar: '#toolbar' },
  placeholder: 'Tulis konten artikel di sini...'
});

// Pre-fill editor with existing article content
quill.root.innerHTML = <%- JSON.stringify(article.content || '') %>;

// Sync content to hidden input on submit
document.getElementById('article-form').addEventListener('submit', function(e) {
  document.getElementById('content-input').value = quill.root.innerHTML;
  if (quill.getText().trim().length < 10) {
    e.preventDefault();
    alert('Konten artikel tidak boleh kosong!');
  }
});

// Thumbnail preview
function previewThumbnail(input) {
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = e => {
      document.getElementById('thumb-preview').innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover absolute inset-0">`;
    };
    reader.readAsDataURL(input.files[0]);
  }
}

// Slug preview
function generateSlugPreview(title) {
  const slug = title.toLowerCase()
    .replace(/[^a-z0-9\s-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .trim();
  document.getElementById('slug-preview').textContent = slug || 'slug-akan-muncul-di-sini';
}
</script>
</body>
</html>
