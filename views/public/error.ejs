<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Portal Berita</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config={theme:{extend:{fontFamily:{sans:['Plus Jakarta Sans','Inter','system-ui','sans-serif']}}}}</script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 font-sans flex items-center justify-center min-h-screen">
  <div class="text-center px-6">
    <div class="text-9xl font-black text-red-100 leading-none"><%= code %></div>
    <h1 class="text-2xl font-bold text-slate-800 mt-4 mb-2"><%= title %></h1>
    <p class="text-slate-500 mb-8 max-w-md"><%= message %></p>
    <div class="flex gap-3 justify-center">
      <a href="/" class="bg-red-600 text-white px-6 py-2.5 rounded-xl font-semibold hover:bg-red-700 transition-colors">🏠 Ke Beranda</a>
      <button onclick="history.back()" class="bg-white text-slate-700 border border-slate-200 px-6 py-2.5 rounded-xl font-semibold hover:border-slate-400 transition-colors">← Kembali</button>
    </div>
  </div>
</body>
</html>
