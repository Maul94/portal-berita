<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= article.excerpt ? article.excerpt.substring(0, 160) : '' %>">
  <meta property="og:title" content="<%= article.title %>">
  <meta property="og:description" content="<%= article.excerpt ? article.excerpt.substring(0, 200) : '' %>">
  <% if (article.thumbnail_url) { %><meta property="og:image" content="<%= article.thumbnail_url %>"><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config={darkMode:'class',theme:{extend:{colors:{primary:{DEFAULT:'#E63946',dark:'#C1121F'}},fontFamily:{sans:['Plus Jakarta Sans','Inter','system-ui','sans-serif']}}}}</script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 font-sans antialiased">

<div id="reading-progress" class="fixed top-0 left-0 h-0.5 bg-gradient-to-r from-red-600 to-orange-400 z-50 transition-all duration-100" style="width:0%"></div>

<%- include('../partials/header') %>
<%- include('../partials/breaking-news') %>

<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- Article Content (centered, max 700px effective) -->
    <article class="lg:col-span-8 lg:col-start-3">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-slate-400 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-red-600 transition-colors">Beranda</a>
        <span>›</span>
        <a href="/kategori/<%= article.category_slug %>" class="hover:text-red-600 transition-colors"><%= article.category_name %></a>
        <span>›</span>
        <span class="text-slate-600 dark:text-slate-400 line-clamp-1"><%= article.title.substring(0, 40) %>...</span>
      </nav>
      
      <!-- Category Badge -->
      <span class="inline-block bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-md uppercase tracking-wide mb-4">
        <%= article.category_name %>
      </span>
      
      <!-- Title -->
      <h1 class="text-2xl md:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white leading-tight mb-4">
        <%= article.title %>
      </h1>
      
      <!-- Excerpt / Lead -->
      <% if (article.excerpt) { %>
      <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed mb-5 font-medium border-l-4 border-red-500 pl-4 italic">
        <%= article.excerpt %>
      </p>
      <% } %>
      
      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-4 text-sm text-slate-500 dark:text-slate-400 pb-5 mb-5 border-b border-slate-100 dark:border-slate-800">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 bg-gradient-to-br from-red-500 to-orange-400 rounded-full flex items-center justify-center text-white font-bold text-sm">
            <%= article.author_name ? article.author_name[0] : 'A' %>
          </div>
          <div>
            <span class="font-semibold text-slate-700 dark:text-slate-300"><%= article.author_name || 'Redaksi' %></span>
          </div>
        </div>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <span>📅 <%= formatDate(article.published_at) %></span>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <span>⏱ <%= article.reading_time_minutes %> menit baca</span>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <span>👁 <%= article.views_count.toLocaleString('id-ID') %> dibaca</span>
      </div>
      
      <!-- Share Buttons (top) -->
      <div class="flex items-center gap-2 mb-6">
        <span class="text-sm text-slate-500 font-medium">Bagikan:</span>
        <a href="https://wa.me/?text=<%= encodeURIComponent(article.title + ' - ' + 'https://portalberita.id/artikel/' + article.slug) %>" target="_blank" rel="noopener" class="inline-flex items-center gap-1 bg-green-500 text-white text-xs font-semibold px-3 py-1.5 rounded-full hover:bg-green-600 transition-colors">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
        <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(article.title) %>&url=<%= encodeURIComponent('https://portalberita.id/artikel/' + article.slug) %>" target="_blank" rel="noopener" class="inline-flex items-center gap-1 bg-slate-900 text-white text-xs font-semibold px-3 py-1.5 rounded-full hover:bg-slate-700 transition-colors">
          𝕏 Twitter
        </a>
        <button id="copy-link-btn" onclick="copyLink()" class="inline-flex items-center gap-1 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-semibold px-3 py-1.5 rounded-full hover:bg-slate-200 dark:hover:bg-slate-600 transition-colors">
          🔗 Salin Tautan
        </button>
      </div>
      
      <!-- Thumbnail -->
      <% if (article.thumbnail_url) { %>
      <figure class="mb-6">
        <div class="thumb-16-9 bg-slate-200 dark:bg-slate-700 rounded-xl overflow-hidden">
          <img src="<%= article.thumbnail_url %>" alt="<%= article.title %>"
            class="w-full h-full object-cover" loading="eager">
        </div>
        <% if (article.thumbnail_caption) { %>
        <figcaption class="text-xs text-slate-400 mt-2 text-center italic"><%= article.thumbnail_caption %></figcaption>
        <% } %>
      </figure>
      <% } %>
      
      <!-- Article Content -->
      <div class="article-content max-w-none">
        <%- article.content %>
      </div>
      
      <!-- Tags -->
      <% if (tags && tags.length > 0) { %>
      <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-800">
        <span class="text-sm font-semibold text-slate-500 dark:text-slate-400 mr-2">🏷️ Topik:</span>
        <% tags.forEach(tag => { %>
        <a href="/cari?q=<%= tag.name %>" class="inline-block bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-medium px-3 py-1 rounded-full mr-2 mb-2 hover:bg-red-100 hover:text-red-700 dark:hover:bg-red-900 dark:hover:text-red-300 transition-colors">
          #<%= tag.name %>
        </a>
        <% }) %>
      </div>
      <% } %>
      
      <!-- Share Buttons (bottom) -->
      <div class="mt-6 p-4 bg-slate-50 dark:bg-slate-800 rounded-xl">
        <p class="text-sm font-semibold text-slate-700 dark:text-slate-300 mb-3 text-center">Apakah artikel ini bermanfaat? Bagikan kepada rekan Anda!</p>
        <div class="flex justify-center gap-2">
          <a href="https://wa.me/?text=<%= encodeURIComponent(article.title + ' - ' + 'https://portalberita.id/artikel/' + article.slug) %>" target="_blank" rel="noopener" class="bg-green-500 text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-green-600 transition-colors">📲 WhatsApp</a>
          <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(article.title) %>" target="_blank" rel="noopener" class="bg-slate-900 text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-slate-700 transition-colors">𝕏 Twitter</a>
          <button onclick="copyLink()" class="bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 text-sm font-semibold px-4 py-2 rounded-lg hover:bg-slate-300 transition-colors">🔗 Salin</button>
        </div>
      </div>
    </article>
  </div>
  
  <!-- Related Articles -->
  <% if (related && related.length > 0) { %>
  <section class="mt-12 pt-8 border-t border-slate-100 dark:border-slate-800">
    <h2 class="text-xl font-extrabold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
      <span class="w-1 h-6 bg-red-600 rounded-full inline-block"></span>
      Berita Terkait
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      <% related.forEach(rel => { %>
      <article class="news-card group bg-white dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-700 overflow-hidden hover:shadow-lg transition-shadow">
        <a href="/artikel/<%= rel.slug %>" class="block">
          <div class="thumb-16-9 bg-slate-200 dark:bg-slate-700 overflow-hidden">
            <% if (rel.thumbnail_url) { %>
            <img src="<%= rel.thumbnail_url %>" alt="<%= rel.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
            <% } else { %>
            <div class="w-full h-full bg-gradient-to-br from-slate-200 to-slate-300 dark:from-slate-700 dark:to-slate-600 flex items-center justify-center">
              <span class="text-2xl">📰</span>
            </div>
            <% } %>
          </div>
          <div class="p-3">
            <span class="text-xs font-semibold text-red-600 uppercase tracking-wide"><%= rel.category_name %></span>
            <h3 class="font-semibold text-sm text-slate-900 dark:text-white mt-1 leading-snug group-hover:text-red-600 transition-colors line-clamp-3">
              <%= rel.title %>
            </h3>
            <span class="text-xs text-slate-400 mt-1 block">🕐 <%= timeAgo(rel.published_at) %></span>
          </div>
        </a>
      </article>
      <% }) %>
    </div>
  </section>
  <% } %>
</div>

<%- include('../partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
