<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="Portal Berita Nasional - Terkini, Terpercaya, Mendalam untuk masyarakat Indonesia.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config={darkMode:'class',theme:{extend:{colors:{primary:{DEFAULT:'#E63946',dark:'#C1121F'}},fontFamily:{sans:['Plus Jakarta Sans','Inter','system-ui','sans-serif']}}}}</script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 font-sans antialiased">

<div id="reading-progress" class="fixed top-0 left-0 h-0.5 bg-gradient-to-r from-red-600 to-orange-400 z-50" style="width:0%"></div>

<%- include('../partials/header') %>
<%- include('../partials/breaking-news') %>

<div class="max-w-7xl mx-auto px-4 py-6">

  <!-- HERO SECTION -->
  <% if (headline) { %>
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-10">
    
    <!-- Main Headline (8 cols) -->
    <div class="lg:col-span-8">
      <article class="news-card group">
        <a href="/artikel/<%= headline.slug %>" class="block">
          <div class="thumb-16-9 bg-slate-200 dark:bg-slate-700 rounded-xl overflow-hidden mb-4">
            <% if (headline.thumbnail_url) { %>
            <img src="<%= headline.thumbnail_url %>" alt="<%= headline.title %>"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="eager">
            <% } else { %>
            <div class="w-full h-full bg-gradient-to-br from-slate-300 to-slate-400 flex items-center justify-center">
              <span class="text-slate-500 text-4xl">📰</span>
            </div>
            <% } %>
          </div>
          
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="bg-red-600 text-white text-xs font-bold px-2.5 py-1 rounded-md uppercase tracking-wide">
                <%= headline.category_name %>
              </span>
              <span class="text-xs text-slate-400">📌 Headline</span>
            </div>
            <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 dark:text-white leading-tight mb-3 group-hover:text-red-600 transition-colors">
              <%= headline.title %>
            </h1>
            <p class="text-slate-500 dark:text-slate-400 text-base leading-relaxed line-clamp-3 mb-3">
              <%= headline.excerpt %>
            </p>
            <div class="flex items-center gap-3 text-xs text-slate-400">
              <span>✍️ <%= headline.author_name %></span>
              <span>•</span>
              <span>🕐 <%= timeAgo(headline.published_at) %></span>
              <span>•</span>
              <span>⏱ <%= headline.reading_time_minutes %> menit baca</span>
            </div>
          </div>
        </a>
      </article>
    </div>
    
    <!-- Trending Sidebar (4 cols) -->
    <div class="lg:col-span-4">
      <div class="bg-slate-50 dark:bg-slate-800 rounded-xl p-5 h-full">
        <h2 class="font-bold text-sm uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-4 flex items-center gap-2">
          <span class="text-red-500">🔥</span> Terpopuler
        </h2>
        <ol class="space-y-4">
          <% trending.forEach((article, i) => { %>
          <li class="flex items-start gap-3 group">
            <span class="text-3xl font-black text-slate-200 dark:text-slate-700 leading-none w-10 flex-shrink-0 group-hover:text-red-200 dark:group-hover:text-red-900 transition-colors">
              <%= String(i + 1).padStart(2, '0') %>
            </span>
            <div>
              <span class="text-xs text-red-500 font-semibold block mb-0.5"><%= article.category_name %></span>
              <a href="/artikel/<%= article.slug %>" class="text-sm font-semibold text-slate-800 dark:text-slate-200 leading-snug hover:text-red-600 transition-colors line-clamp-3">
                <%= article.title %>
              </a>
              <div class="text-xs text-slate-400 mt-1">👁 <%= article.views_count.toLocaleString('id-ID') %> pembaca</div>
            </div>
          </li>
          <% if (i < trending.length - 1) { %><li class="border-t border-slate-200 dark:border-slate-700"></li><% } %>
          <% }) %>
        </ol>
      </div>
    </div>
  </section>
  <% } %>

  <!-- LATEST NEWS SECTION -->
  <section>
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-xl font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
        <span class="w-1 h-6 bg-red-600 rounded-full inline-block"></span>
        Berita Terkini
      </h2>
      <a href="/cari" class="text-sm text-red-600 hover:underline font-medium">Lihat Semua →</a>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      <% latest.forEach(article => { %>
      <article class="news-card group bg-white dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-700 overflow-hidden hover:shadow-lg transition-shadow">
        <a href="/artikel/<%= article.slug %>" class="block">
          <div class="thumb-16-9 bg-slate-200 dark:bg-slate-700 overflow-hidden">
            <% if (article.thumbnail_url) { %>
            <img src="<%= article.thumbnail_url %>" alt="<%= article.title %>"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy">
            <% } else { %>
            <div class="w-full h-full bg-gradient-to-br from-slate-200 to-slate-300 dark:from-slate-700 dark:to-slate-600 flex items-center justify-center">
              <span class="text-3xl">📰</span>
            </div>
            <% } %>
          </div>
          <div class="p-4">
            <span class="text-xs font-semibold text-red-600 uppercase tracking-wide"><%= article.category_name %></span>
            <h3 class="font-bold text-slate-900 dark:text-white mt-1 mb-2 leading-snug group-hover:text-red-600 transition-colors line-clamp-3">
              <%= article.title %>
            </h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 mb-3"><%= article.excerpt %></p>
            <div class="flex items-center justify-between text-xs text-slate-400">
              <span>🕐 <%= timeAgo(article.published_at) %></span>
              <span>⏱ <%= article.reading_time_minutes %> mnt</span>
            </div>
          </div>
        </a>
      </article>
      <% }) %>
    </div>
  </section>
</div>

<%- include('../partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
